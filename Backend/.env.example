# ---------------------------------------------------------
# Rental Management System — Backend Environment Variables
#
# Copy this file to `.env` at the repository root and fill in
# the real values. Never commit `.env` (secrets) to version control.
# ---------------------------------------------------------

# Django
SECRET_KEY=change-me-to-a-strong-random-secret-key
DEBUG=False
ALLOWED_HOSTS=rentalconnect.kamategroup.online,localhost,127.0.0.1

# PostgreSQL (db service)
DB_NAME=rentaldb
DB_USER=rentaluser
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://rentalconnect.kamategroup.online